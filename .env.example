# === TelcoAgent Platform Environment Variables ===

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=telco
POSTGRES_PASSWORD=telco_secret
POSTGRES_DB=telcoagent

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=telco_episodic

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Internal Service URLs (use Docker service names when running in Docker)
CUSTOMER_SERVICE_URL=http://localhost:8001/v1/customers
BILLING_SERVICE_URL=http://localhost:8002/v1/billing
NETWORK_SERVICE_URL=http://localhost:8003/v1/network
CAMPAIGN_SERVICE_URL=http://localhost:8004/v1/campaigns

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=telco-agents
KEYCLOAK_CLIENT_ID=agent-orchestrator
KEYCLOAK_CLIENT_SECRET=change-me

# Temporal
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=telco-agents

# LLM (DeepSeek API — OpenAI compatible)
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=your-deepseek-api-key

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=telco-agent-platform

# Observability
JAEGER_ENDPOINT=http://localhost:14268/api/traces
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
