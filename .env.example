# === TelcoAgent Platform Environment Variables ===

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=telco
POSTGRES_PASSWORD=telco_secret
POSTGRES_DB=telcoagent

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Internal Service URLs (use Docker service names when running in Docker)
CUSTOMER_SERVICE_URL=http://localhost:8001/v1/customers
BILLING_SERVICE_URL=http://localhost:8002/v1/billing
NETWORK_SERVICE_URL=http://localhost:8003/v1/network
CAMPAIGN_SERVICE_URL=http://localhost:8004/v1/campaigns

# JWT Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# LLM (DeepSeek API — OpenAI compatible)
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=your-deepseek-api-key

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=telco-agent-platform

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
DEV_MODE=false
