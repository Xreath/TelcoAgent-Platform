{
  "realm": "telco-agents",
  "enabled": true,
  "displayName": "TelcoAgent Platform",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "agent-operator",
        "description": "Can run agents and view results"
      },
      {
        "name": "agent-supervisor",
        "description": "Can override agent decisions"
      },
      {
        "name": "agent-auditor",
        "description": "Read-only access to agent logs and decisions"
      }
    ]
  },
  "clients": [
    {
      "clientId": "customer-service",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "customer-service-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "publicClient": false
    },
    {
      "clientId": "network-service",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "network-service-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "publicClient": false
    },
    {
      "clientId": "billing-service",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "billing-service-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "publicClient": false
    },
    {
      "clientId": "campaign-service",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "campaign-service-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "publicClient": false
    },
    {
      "clientId": "agent-orchestrator",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "agent-orchestrator-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "publicClient": false
    },
    {
      "clientId": "admin-ui",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3001"]
    }
  ],
  "scopeMappings": [
    {
      "client": "agent-orchestrator",
      "roles": ["agent-operator"]
    },
    {
      "client": "admin-ui",
      "roles": ["agent-supervisor", "agent-auditor"]
    }
  ],
  "users": [
    {
      "username": "admin-user",
      "enabled": true,
      "email": "admin@telcoagent.local",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["agent-supervisor", "agent-auditor"]
    },
    {
      "username": "operator-user",
      "enabled": true,
      "email": "operator@telcoagent.local",
      "credentials": [
        {
          "type": "password",
          "value": "operator123",
          "temporary": false
        }
      ],
      "realmRoles": ["agent-operator"]
    }
  ]
}
